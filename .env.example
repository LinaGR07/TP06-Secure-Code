# Copy this file to .env and fill in real values. Never commit .env.
# Generate a strong key with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me
# "development" enables Swagger UI (/docs). Defaults to "production" when unset.
APP_ENV=development
# Max login attempts per client IP. Defaults to "5/minute" (production) when unset.
# Raised here because the test suite logs in many times in a row.
LOGIN_RATE_LIMIT=100/minute
# Password of the admin account created by init_db(). Choose a strong one.
ADMIN_PASSWORD=change-me